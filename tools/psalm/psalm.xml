<?xml version="1.0"?>
<!--
    Lives next to the isolated Psalm install in tools/psalm/. resolveFromConfigFile is off, so paths
    below resolve against the project root (where `composer psalm` runs) and Psalm loads the
    project's own vendor/autoload.php from there.
-->
<psalm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="https://getpsalm.org/schema/config"
       xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
       errorLevel="1"
       resolveFromConfigFile="false"
       findUnusedBaselineEntry="false"
       findUnusedCode="false"
       errorBaseline="tools/psalm/psalm-baseline.xml"
>
    <issueHandlers>
        <RedundantConditionGivenDocblockType errorLevel="suppress"/>
        <RedundantCastGivenDocblockType errorLevel="suppress"/>
        <PropertyNotSetInConstructor errorLevel="suppress"/>
        <MissingConstructor errorLevel="suppress"/>
    </issueHandlers>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
            <directory name="tests"/>
        </ignoreFiles>
    </projectFiles>
</psalm>
