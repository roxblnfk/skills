/.*/
!/.phive/
!/.github/
!/.phar/
/runtime/
/vendor/
/.env
*.log
*.exe

# Root-level Markdown holds local-only planning notes; whitelist tracked docs.
/*.md
!/README.md
!/CHANGELOG.md
!/AGENTS.md
!/LICENSE.md

# Tools installed via bamarni/composer-bin-plugin.
/tools/*/vendor/
/tools/*/composer.lock

# Personal llm/skills layer over skills.json.
/skills.local.json
