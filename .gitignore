/.*/
!/.phive/
!/.github/
!/.phar/
/runtime/
/vendor/
/.env
*.log
*.exe

# Root-level Markdown holds local-only planning notes; whitelist tracked docs.
/*.md
!/README.md
!/CHANGELOG.md
!/CLAUDE.md
!/LICENSE.md

# Tools installed via bamarni/composer-bin-plugin.
/tools/*/vendor/
/tools/*/composer.lock
