{
    "name": "llm/skills",
    "type": "composer-plugin",
    "description": "AI skills discovery and management system for LLM agents",
    "license": "BSD-3-Clause",
    "keywords": [
        "ai",
        "llm",
        "skills",
        "agents",
        "ai-skills",
        "ai-agents",
        "llm-agents",
        "claude-code",
        "dev"
    ],
    "support": {
        "issues": "https://github.com/roxblnfk/skills/issues",
        "source": "https://github.com/roxblnfk/skills"
    },
    "authors": [
        {
            "name": "Aleksei Gagarin",
            "email": "roxblnfk@gmail.com"
        }
    ],
    "funding": [
        {
            "type": "boosty",
            "url": "https://boosty.to/roxblnfk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer-plugin-api": "^2.0",
        "internal/path": "^1.4"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "buggregator/trap": "^1.16",
        "composer/composer": "^2.10.3",
        "roxblnfk/unpoly": "^1.8",
        "testo/bridge-infection": "0.1 - 1",
        "testo/testo": "0.10 - 1"
    },
    "suggest": {
        "ext-intl": "Detects skill names that differ only in Unicode composition; without it or its Symfony polyfill non-ASCII skill names are skipped",
        "ext-mbstring": "Detects skill names that differ only in non-ASCII letter case; without it non-ASCII skill names are skipped"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LLM\\Skills\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LLM\\Skills\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "LLM\\Skills\\Composer\\SkillsPlugin",
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "tools"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=tools/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=tools/code-style/.php-cs-fixer.dist.php",
        "psalm": "psalm -c tools/psalm/psalm.xml",
        "psalm:baseline": "psalm -c tools/psalm/psalm.xml --set-baseline=tools/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c tools/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "test": [
            "@putenv XDEBUG_MODE=coverage",
            "testo"
        ],
        "test:ci": [
            "@putenv TESTO_CI=1",
            "@putenv XDEBUG_MODE=coverage",
            "testo"
        ],
        "infect": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --threads=max"
        ],
        "infect:ci": [
            "@putenv TESTO_CI=1",
            "@putenv XDEBUG_MODE=coverage",
            "infection --ansi --logger-github --threads=max --show-mutations=0"
        ]
    }
}
